<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>Larcanum.Retention.UnitTests</AssemblyName>
        <RootNamespace>Larcanum.Retention.UnitTests</RootNamespace>
        <!-- Underscore-separated test method names (Given_When_Then) are intentional -->
        <NoWarn>$(NoWarn);CA1707</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="AwesomeAssertions" Version="9.3.0" />
        <PackageReference Include="TUnit" Version="1.3.0" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Retention\Retention.csproj" />
    </ItemGroup>

</Project>
